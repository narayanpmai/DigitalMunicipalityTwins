# ==============================================================
# P5 DIGITAL TWIN - Environment Variables
# Panchpokhari Thangpal Rural Municipality
# Copy this to .env and fill in your values
# ==============================================================

# Application
NODE_ENV=development
APP_NAME="P5 Digital Twin"
APP_VERSION=1.0.0
APP_PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p5digital
DB_USER=p5admin
DB_PASSWORD=P5Digital@2024!
DB_SCHEMA=public
DB_LOGGING=false
DB_SYNC=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=p5digital-jwt-secret-change-in-production-minimum-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=p5digital-refresh-secret-change-in-production-minimum-32-chars
JWT_REFRESH_EXPIRES=7d

# AI - Google Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI - OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI - Ollama (local, alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector Database (for RAG)
VECTOR_DB_TYPE=pgvector
# or: pinecone, qdrant, weaviate

# Object Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# For S3/MinIO:
# STORAGE_TYPE=s3
# STORAGE_S3_BUCKET=p5digital
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="P5 Digital Twin <noreply@panchpokhari.gov.np>"

# SMS (abstraction - set provider)
SMS_PROVIDER=mock
# Options: sparrow, aakash, mock
SPARROW_TOKEN=
AAKASH_USER=
AAKASH_PASSWORD=

# Push Notifications
PUSH_PROVIDER=mock
FCM_SERVER_KEY=

# GIS
DEFAULT_MAP_CENTER_LAT=27.9475
DEFAULT_MAP_CENTER_LNG=85.7103
DEFAULT_MAP_ZOOM=12

# Tourist Camera System
CAMERA_SYSTEM=mock
# Options: mock, custom_rtsp, cloud_ai
CAMERA_VIDEO_RETENTION_DAYS=7

# IoT / Sensors
IOT_GATEWAY=mock
# Options: mock, mqtt, http_polling

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cors
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Audit
AUDIT_LOG_ENABLED=true

# QR Code Base URL (for public project profiles)
QR_BASE_URL=http://localhost:5173

# Report Generation
REPORT_OUTPUT_DIR=./reports

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Demo / Seed
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@p5digital.local
DEMO_ADMIN_PASSWORD=Admin@P5Digital2024!
