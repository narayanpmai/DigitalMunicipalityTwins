# ==============================================================================
# Panchpokhari Thangpal Rural Municipality — Municipal Digital Twins
# Production Environment Configuration Template
# Instructions: Copy this file to .env.production and populate secure secrets.
# ==============================================================================

# Node.js Environment
NODE_ENV=production
PORT=3001

# PostGIS Database Connection
DB_HOST=db
DB_PORT=5432
DB_USER=p5admin
# IMPORTANT: Generate a strong, 24+ character password for production:
DB_PASSWORD=P5_Prod_Secure_Passwd_2026!
DB_NAME=p5digital
# Set DB_SYNC=false in production; use TypeORM migrations for schema management:
DB_SYNC=false

# Python FastAPI Microservice Endpoint (Internal Docker Network)
AI_SERVICE_URL=http://ai_service:8000

# Authentication & Security
# Generate random 64-character hex key (e.g. openssl rand -hex 32):
JWT_SECRET=super_secret_jwt_key_panchpokhari_thangpal_change_in_production_2026
JWT_EXPIRATION=8h

# CORS Whitelist (Comma-separated exact domains allowed in production)
CORS_ORIGIN=https://digitaltwin.panchpokharimun.gov.np,https://admin.panchpokharimun.gov.np

# Google Gemini / LLM Integration (Optional - Falls back to FastAPI Microservice RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Emergency Bulk SMS Gateway Credentials (Sparrow / NTC / Ncell)
SMS_GATEWAY_URL=https://api.sparrowsms.com/v2/sms/
SMS_GATEWAY_TOKEN=
SMS_SENDER_IDENTITY=PALIKA-EWS

# WhatsApp Business API Credentials
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
